ARG VERSION=v7.1.0
ARG TIFLASH_VERSION=v7.5.0

FROM hub-new.pingcap.net/keyspace/tidb:${VERSION} as tidb
FROM hub-new.pingcap.net/keyspace/pd:${VERSION} as pd
FROM hub-new.pingcap.net/keyspace/tiflash:${TIFLASH_VERSION} as tiflash
FROM hub-new.pingcap.net/kvaas/go-tpc:small-size as go-tpc

FROM amazonlinux:2022.0.20220504.1
RUN yum update -y && yum install -y procps

# Uncomment following lines to use ubuntu >= 22.04 for profiling.
# It's not easy to install jemalloc-dev on amazonlinux.
#
# FROM ubuntu:22.04
# ARG DEBIAN_FRONTEND=noninteractive
# ENV TZ=UTC
# RUN sed -i s@/archive.ubuntu.com/@/apt.ksyun.cn/@g /etc/apt/sources.list && \
#     sed -i s@/security.ubuntu.com/@/apt.ksyun.cn/@g /etc/apt/sources.list && \
#     apt-get update -y && apt-get install -y \
#     tzdata \
#     binutils \
#     libjemalloc-dev \
#     graphviz \
#     ghostscript \
#     curl

COPY --from=tidb /tidb-server /tidb-server
COPY --from=pd /pd-server /pd-server
COPY --from=tiflash /tiflash /tiflash
COPY --from=go-tpc /go-tpc /go-tpc

ENV TIDB_BIN=/tidb-server
ENV PD_BIN=/pd-server
ENV TIFLASH_BIN=/tiflash/tiflash
ENV TPC_BIN=/go-tpc
